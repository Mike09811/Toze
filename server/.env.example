# 应用
APP_NAME=toze
APP_ENV=development
# HTTP
HTTP_ADDR=:8088
HTTP_CORS_ORIGINS=http://localhost:7802,http://127.0.0.1:7802
HTTP_STATIC_DIR=../web/dist
# MySQL
DB_HOST=127.0.0.1
DB_PORT=33306
DB_USER=root
DB_PASSWORD=admin123
DB_NAME=toze
DB_AUTO_MIGRATE=true
DB_SEED=true
# JWT
JWT_SECRET=change-me-in-production-please-32bytes
JWT_ISSUER=toze
JWT_TTL=24h
# 日志
LOG_LEVEL=info
LOG_FORMAT=text
# PaaS：SSH 凭证落库加密密钥（任意字符串，一旦设置不可更换，否则已存凭证无法解密）
PAAS_AES_KEY=please-change-this-aes-key
